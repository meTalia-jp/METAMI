/src/test_check.py

# 実行時に生成されるユーザーデータ
/data/*
!/data/.gitkeep
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ログ、出力、テスト生成物
*.log
/logs/
/output/
/outputs/
/build/
/dist/
/.test_artifacts/
