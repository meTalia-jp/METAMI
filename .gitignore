/.ver*_scale*.png
/.ver*_focus.png
*.tmp
*.temp
*.bak
*.swp
*~

# ユーザー固有設定・秘密情報
.env
.env.*
!.env.example
*.local.json
*.local.toml
*.local.yaml
*.local.yml

# IDE・エディター固有設定
/.idea/
